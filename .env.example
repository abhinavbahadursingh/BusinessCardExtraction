# Default (nothing set): mock demo mode — no key needed, labeled sample data.
# --- Real Qwen-VL via Hugging Face (recommended) ---
# 1. Free token at https://huggingface.co/settings/tokens
#    (fine-grained token with "Make calls to Inference Providers" permission)
# 2. Uncomment below, paste token, restart the backend.
# QWEN_PROVIDER=huggingface
# HF_TOKEN=hf-...
# Optional: pin the model (default Qwen/Qwen3-VL-8B-Instruct:featherless-ai —
# the :provider pin is required, auto-routing fails for this model)
# QWEN_MODEL=Qwen/Qwen3-VL-8B-Instruct:featherless-ai
# (Enable providers at https://huggingface.co/settings/inference-providers)

# --- Alternatives ---
# QWEN_PROVIDER=openrouter   (needs a few $ credit, no free Qwen-VL right now)
# OPENROUTER_API_KEY=sk-or-...
# QWEN_MODEL=qwen/qwen3-vl-8b-instruct

# QWEN_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-...
# QWEN_MODEL=qwen-vl-max

# QWEN_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# QWEN_MODEL=qwen2-vl

APP_URL=http://localhost:8000
PORT=8000
